# Local contribution sync config lives outside the repo:
#   ~/.config/baxterkemp-contributions/config.json
#
# Create it with:
#   npm run setup
#
# Example shape:
# {
#   "siteRepo": "/Users/you/baxterkemp.com",
#   "githubUsername": "baxterkempdev",
#   "githubToken": "ghp_...",
#   "cursorEmail": "you@example.com",
#   "cursorPassword": "...",
#   "claudeDir": "/Users/you/.claude"
# }
#
# githubToken: use a classic PAT (not fine-grained).
#   https://github.com/settings/tokens → Generate new token (classic)
#   Scope: read:user  (optional: repo, for private contributions)
# Fine-grained tokens do not expose read:user.
# Or omit githubToken and use `gh auth login` / `gh auth token`.
#
# Playwright session cache: ~/.config/baxterkemp-contributions/storageState.json
#
# One-time:
#   npm install
#   npm run setup
#   npm run install-hook
#   npm run sync -- --force
